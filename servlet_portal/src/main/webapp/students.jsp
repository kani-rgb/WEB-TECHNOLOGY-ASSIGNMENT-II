<%@ page import="java.util.*" %><!doctype html><html><head><meta charset="utf-8"><title>Students</title><link rel="stylesheet" href="assets/style.css"></head><body><div class="wide"><header><div><h1>Student Profiles</h1><p>Loaded dynamically using Servlet + JDBC.</p></div><a href="logout">Logout</a></header><% List<Map<String,Object>> students=(List<Map<String,Object>>)request.getAttribute("students"); if(students!=null){ for(Map<String,Object> s:students){ %><article><h2><%=s.get("name")%></h2><p><b>Roll:</b> <%=s.get("roll")%> · <b>Email:</b> <%=s.get("email")%></p><p><b>Course:</b> <%=s.get("course")%></p><%-- The servlet endpoint streams associated files when IDs are listed. --%><p><a href="file?id=1">Open associated file (if available)</a></p></article><% }} %></div></body></html>
